{
  "name": "turborepodockerdeploy",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:migrate": "cd packages/db && pnpm dlx prisma migrate deploy && cd ../../",
    "db:generate": "cd packages/db && pnpm dlx prisma generate && cd ../../",
    "db:seed": "cd packages/db && pnpm run seed && cd ../../",
    "db:build": "pnpm run --filter=@repo/db build",
    "docker:up": "docker-compose up -d",
    "frontend:build": "pnpm run --filter=frontend build",
    "frontend:start": "cd apps/frontend && pnpm exec vite preview --host 0.0.0.0 --port 3000",
    "backend:build": "pnpm run --filter=backend build",
    "backend:start": "pnpm run db:migrate && pnpm run db:seed && cd apps/backend && pnpm run start",
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.7.4",
    "turbo": "^2.9.7",
    "typescript": "5.9.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "pnpm exec eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "globals": "^17.6.0"
  }
}
